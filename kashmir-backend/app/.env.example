# Kashmir Platform — Backend Environment Variables (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` (same folder) and fill in real values.
# The real `.env` is git-ignored — never commit it.
# Setup guide: see /setup/SETUP-GUIDE.md at the project root.
# ═══════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────
APP_SECRET_KEY=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
DOCUMENTARY_PRICE_INR=1

# ── JWT (film access token) ─────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Airpay (film payment gateway) ───────────────────────────────
# Get keys after being approved as a merchant on airpay.co.in
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_API_KEY=
AIRPAY_CLIENT_ID=
AIRPAY_SECRET_KEY=
AIRPAY_IS_TEST=true
AIRPAY_BASE_URL=https://payments.airpay.co.in/pay/index.php

# ── CMS auth (Kashmir Harvest admin panel) ──────────────────────
# Pick a strong password. Never commit real values.
CMS_PASSWORD=
CMS_JWT_SECRET=change-this-to-a-long-random-string

# ── Supabase (database + product image storage) ─────────────────
# From: Supabase dashboard → Project Settings → API
# service_role key is a master key — server-side only, never expose to browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Brevo (transactional emails for orders) ─────────────────────
# From: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_FROM_EMAIL=orders@yourdomain.com
BREVO_ADMIN_EMAIL=admin@yourdomain.com

# ── Ayrshare (social media publishing) ──────────────────────────
# From: app.ayrshare.com → API Key
AYRSHARE_API_KEY=

# ── X / Twitter (BYOK — optional, only for X posting via Ayrshare) ──
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── News (optional — RSS feeds work without this) ───────────────
NEWS_API_KEY=

# ── Apify (optional — social feed uses mock posts without this) ──
APIFY_API_TOKEN=
